<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tabletop Character Forge</title>
<style>
/* =========================================================================
   Theme — dark leather & parchment, gold trim (BG3-flavored)
   ========================================================================= */
:root {
  --bg:      #100e0c;
  --bg2:     #171410;
  --panel:   #1e1a15;
  --panel2:  #262119;
  --line:    #3a3226;
  --line2:   #4d4232;
  --ink:     #e9dfc8;
  --muted:   #a89a7e;
  --faint:   #776c55;
  --gold:    #d8a94f;
  --gold2:   #f0c979;
  --green:   #7fae6b;
  --red:     #c05a4a;
  --blue:    #6f9cc9;
  --purple:  #9c7fc9;
  --shadow:  0 6px 24px rgba(0,0,0,.45);
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0; background: radial-gradient(1200px 600px at 70% -10%, #1c1812 0%, var(--bg) 55%);
  color: var(--ink); font-family: Georgia, 'Times New Roman', serif; font-size: 15px;
}
a { color: var(--blue); }
h1,h2,h3 { font-weight: normal; letter-spacing: .5px; }
button { font-family: 'Segoe UI', system-ui, sans-serif; }
.mono { font-family: 'Cascadia Code', Consolas, monospace; font-size: .92em; }

/* ---- top bar ---------------------------------------------------------- */
header {
  position: sticky; top: 0; z-index: 50;
  display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
  padding: 12px 22px; background: rgba(16,14,12,.94); backdrop-filter: blur(6px);
  border-bottom: 1px solid var(--line2);
}
header .brand { font-size: 19px; color: var(--gold); letter-spacing: 1.5px; }
header .brand small { color: var(--muted); font-family: sans-serif; font-size: 11px; letter-spacing: .3px; margin-left: 8px; }
header select, header input[type=text] {
  background: var(--panel2); color: var(--ink); border: 1px solid var(--line2);
  border-radius: 7px; padding: 7px 10px; font-family: inherit; font-size: 13.5px; min-width: 190px;
}
header select:focus, header input:focus { outline: none; border-color: var(--gold); }
.saved-strip { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
.saved-strip .chip {
  font-family: sans-serif; font-size: 11.5px; cursor: pointer;
  background: var(--panel2); border: 1px solid var(--line2); color: var(--muted);
  padding: 4px 10px; border-radius: 999px; display: inline-flex; gap: 6px; align-items: center;
}
.saved-strip .chip:hover { border-color: var(--gold); color: var(--ink); }
.saved-strip .chip b { color: var(--gold2); font-weight: 600; }
.saved-strip .chip .del { color: var(--red); opacity: .7; }
.saved-strip .chip .del:hover { opacity: 1; }

/* ---- layout: sticky rail + content ------------------------------------- */
.cols { display: grid; grid-template-columns: 190px 1fr; max-width: 1180px; margin: 0 auto; gap: 0; }
nav.rail {
  position: sticky; top: 62px; align-self: start; height: calc(100vh - 62px);
  padding: 26px 10px 26px 22px; display: flex; flex-direction: column; gap: 2px;
}
nav.rail a {
  color: var(--muted); text-decoration: none; font-family: 'Segoe UI', system-ui, sans-serif;
  font-size: 13px; padding: 8px 12px; border-radius: 7px; border-left: 2px solid transparent;
}
nav.rail a:hover { color: var(--ink); background: var(--panel); }
nav.rail a.active { color: var(--gold2); border-left-color: var(--gold); background: var(--panel); }
main { padding: 26px 0 90px 22px; min-width: 0; }

/* ---- cards --------------------------------------------------------------- */
section.card {
  background: var(--panel); border: 1px solid var(--line); border-radius: 10px;
  padding: 20px 22px; margin-bottom: 18px; box-shadow: var(--shadow);
}
section.card > h2 {
  margin: 0 0 3px; font-size: 18px; color: var(--gold);
  display: flex; align-items: center; gap: 9px;
}
section.card > h2 .ico { font-size: 20px; filter: saturate(.8); }
section.card > p.hint { margin: 0 0 16px; color: var(--muted); font-size: 12.5px; font-family: sans-serif; }
label { display: block; font-family: sans-serif; font-size: 11px; color: var(--muted);
  text-transform: uppercase; letter-spacing: .7px; margin: 13px 0 5px; }
input[type=text], input[type=number], textarea, select {
  width: 100%; background: var(--bg2); color: var(--ink); border: 1px solid var(--line);
  border-radius: 7px; padding: 8.5px 11px; font-family: inherit; font-size: 14px;
}
input:focus, textarea:focus, select:focus { outline: none; border-color: var(--gold); background: #1d1913; }
textarea { resize: vertical; min-height: 62px; }
.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 18px; }
.grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0 18px; }
@media (max-width: 860px) { .grid2, .grid3 { grid-template-columns: 1fr; } .cols { grid-template-columns: 1fr; } nav.rail { display: none; } }

.badge { font-family: sans-serif; font-size: 10.5px; padding: 2.5px 9px; border-radius: 999px;
  border: 1px solid var(--line2); color: var(--muted); vertical-align: 2px; margin-left: 6px; }
.badge.local { border-color: var(--green); color: var(--green); }
.badge.remote { border-color: var(--blue); color: var(--blue); }
.badge.gold { border-color: var(--gold); color: var(--gold); }

/* ---- system TLDR panel -------------------------------------------------- */
.syspanel { display: grid; grid-template-columns: 300px 1fr; gap: 18px; align-items: start; }
@media (max-width: 980px) { .syspanel { grid-template-columns: 1fr; } }
.syspanel .tldr { background: var(--bg2); border: 1px solid var(--line); border-left: 3px solid var(--gold);
  border-radius: 8px; padding: 13px 15px; margin-top: 14px; font-size: 13.5px; line-height: 1.55; color: #d6ccba; }
.syspanel .links { display: flex; flex-direction: column; gap: 7px; margin-top: 12px; font-family: sans-serif; font-size: 12.5px; }
.syspanel .links .l { display: flex; gap: 9px; align-items: baseline; }
.syspanel .links .l b { color: var(--muted); font-weight: 600; min-width: 74px; font-size: 11px; text-transform: uppercase; letter-spacing: .5px; }
.syspanel .links a { word-break: break-all; }

/* ---- identity ------------------------------------------------------------ */
.idrow { display: flex; gap: 18px; align-items: flex-start; flex-wrap: wrap; }
.portrait {
  flex: 0 0 auto; width: 118px; height: 118px; border-radius: 12px; cursor: pointer;
  background: linear-gradient(160deg, #2a241b, #191510); border: 2px solid var(--line2);
  display: flex; align-items: center; justify-content: center; font-size: 52px;
  box-shadow: inset 0 0 30px rgba(0,0,0,.6);
}
.portrait small { position: absolute; color: var(--faint); }
.portrait-wrap { position: relative; }
.portrait-pick { display: flex; gap: 5px; flex-wrap: wrap; max-width: 130px; margin-top: 7px; }
.portrait-pick button { background: var(--panel2); border: 1px solid var(--line); border-radius: 7px;
  font-size: 17px; padding: 3px 6px; cursor: pointer; line-height: 1.2; }
.portrait-pick button:hover { border-color: var(--gold); }
.chip-row { display: flex; gap: 7px; flex-wrap: wrap; margin-top: 11px; }
.chip {
  font-family: sans-serif; font-size: 12px; padding: 5px 11px; border-radius: 999px;
  background: var(--panel2); border: 1px solid var(--line2); color: var(--ink);
  display: inline-flex; gap: 7px; align-items: center;
}
.chip.lookupable { cursor: pointer; }
.chip.lookupable:hover { border-color: var(--gold); color: var(--gold2); }
.chip .k { color: var(--faint); text-transform: uppercase; font-size: 10px; letter-spacing: .5px; }
.chip .lv { color: var(--gold2); font-weight: 700; }

/* suggestions (chips under inputs) */
.suggestions { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 6px; }
.suggestions button { background: transparent; border: 1px solid var(--line); color: var(--muted);
  font-size: 11.5px; padding: 3px 9px; border-radius: 999px; cursor: pointer; }
.suggestions button:hover { border-color: var(--gold); color: var(--gold2); }
.suggestions button.match { border-color: var(--green); color: var(--green); }

/* ---- ability tiles -------------------------------------------------------- */
.ability-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(128px, 1fr)); gap: 10px; margin-top: 6px; }
.ab-tile {
  background: var(--bg2); border: 1px solid var(--line); border-radius: 9px; padding: 11px 12px 9px;
  cursor: pointer; transition: border-color .12s;
}
.ab-tile:hover { border-color: var(--gold); }
.ab-tile .abname { font-family: sans-serif; font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: .7px; display: flex; justify-content: space-between; }
.ab-tile .abname .ic { font-size: 15px; }
.ab-tile input { border: none; background: transparent; text-align: center; font-size: 30px; color: var(--gold2);
  font-family: Georgia, serif; padding: 2px 0; width: 100%; -moz-appearance: textfield; }
.ab-tile input::-webkit-inner-spin-button { -webkit-appearance: none; }
.ab-tile .modline { text-align: center; font-family: sans-serif; font-size: 12px; color: var(--muted); min-height: 17px; }
.ab-tile .modline b { color: var(--ink); font-size: 14px; }
.ab-tile .skills-hint { text-align: center; font-family: sans-serif; font-size: 10.5px; color: var(--faint); min-height: 14px; }

/* ---- generic lists (skills, spells, features) ----------------------------- */
.kb-toolbar { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin: 8px 0 12px; font-family: sans-serif; }
.kb-toolbar input[type=text], .kb-toolbar select { width: auto; min-width: 130px; font-size: 12.5px; padding: 6px 9px; }
.kb-toolbar label { margin: 0; display: inline-flex; gap: 6px; align-items: center; font-size: 12px; }
.kb-list { display: flex; flex-direction: column; gap: 6px; max-height: 420px; overflow: auto; padding-right: 4px; }
.kb-item {
  background: var(--bg2); border: 1px solid var(--line); border-radius: 8px; padding: 9px 13px;
  display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; align-items: center; cursor: pointer;
}
.kb-item:hover { border-color: var(--gold); }
.kb-item .ti { font-size: 15px; }
.kb-item .ti .tag { font-family: sans-serif; font-size: 10px; color: var(--blue); border: 1px solid var(--line2);
  border-radius: 4px; padding: 1px 6px; margin-left: 7px; vertical-align: 1px; }
.kb-item .ti .tag.r { color: var(--purple); }
.kb-item .sub { grid-column: 1 / -1; font-family: sans-serif; font-size: 11.5px; color: var(--faint);
  display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
.kb-item .act { display: flex; gap: 6px; }
.kb-item .act button { font-size: 11px; padding: 3px 10px; border-radius: 6px; cursor: pointer;
  background: var(--panel2); border: 1px solid var(--line2); color: var(--muted); }
.kb-item .act button:hover { color: var(--gold2); border-color: var(--gold); }
.kb-item .act button.on { color: var(--green); border-color: var(--green); }

/* proficiency checkboxes inside skill rows */
.prof { grid-column: 1 / -1; display: flex; gap: 6px; align-items: center; font-family: sans-serif; font-size: 12px; color: var(--muted); margin-top: 3px; }
.prof .opt { padding: 3px 10px; border-radius: 6px; border: 1px solid var(--line2); background: var(--panel2);
  color: var(--muted); cursor: pointer; font-size: 11px; }
.prof .opt.on { border-color: var(--gold); color: var(--gold2); background: #2b2313; }
.prof .opt.exp.on { border-color: var(--green); color: var(--green); }
.prof .pb { margin-left: auto; color: var(--faint); font-size: 11px; }

/* feature level accordion */
.lvlrow { border: 1px solid var(--line); border-radius: 8px; margin-bottom: 6px; background: var(--bg2); overflow: hidden; }
.lvlrow summary {
  cursor: pointer; list-style: none; padding: 9px 13px; font-family: sans-serif; font-size: 13px;
  display: flex; gap: 10px; align-items: center; color: var(--muted);
}
.lvlrow summary::-webkit-details-marker { display: none; }
.lvlrow summary .lvb { color: var(--gold2); font-weight: 700; min-width: 26px; }
.lvlrow[open] summary { color: var(--ink); background: #211c14; }
.lvlrow.now { border-color: var(--gold); }
.lvlrow.now summary .lvb::after { content: "  ◄ your level"; color: var(--gold); font-size: 10.5px; font-weight: 400; }
.lvlrow .feat { padding: 4px 13px 11px 48px; }
.lvlrow .feat b { color: var(--gold2); }
.lvlrow .feat p { margin: 2px 0 9px; color: #cfc5af; font-size: 13.5px; line-height: 1.5; }
.lvlrow .feat .prereq { font-family: sans-serif; font-size: 11px; color: var(--purple); }

/* ---- campaign ------------------------------------------------------------- */
.camp-detail { margin-top: 12px; display: none; }
.camp-detail.show { display: block; }
.camp-grid { display: grid; grid-template-columns: 200px 1fr; gap: 16px; }
@media (max-width: 860px) { .camp-grid { grid-template-columns: 1fr; } }
.camp-meta .row { display: flex; gap: 8px; font-family: sans-serif; font-size: 12px; margin-bottom: 7px; }
.camp-meta .row b { color: var(--muted); font-weight: 600; min-width: 88px; font-size: 10.5px; text-transform: uppercase; letter-spacing: .5px; padding-top: 2px; }
.worldnotes { background: var(--bg2); border: 1px solid var(--line); border-left: 3px solid var(--blue);
  border-radius: 8px; padding: 12px 14px; margin-top: 10px; font-size: 13px; line-height: 1.6; color: #cfc7b2; white-space: pre-wrap; }
.camp-actions { margin-top: 10px; display: flex; gap: 8px; }
.btn { background: var(--gold); color: #1a1508; border: none; border-radius: 8px; padding: 10px 20px;
  font-size: 14px; font-weight: 700; cursor: pointer; letter-spacing: .3px; }
.btn:hover { background: var(--gold2); }
.btn:disabled { opacity: .5; cursor: wait; }
.btn.small { padding: 6px 13px; font-size: 12.5px; font-weight: 600; background: var(--panel2); color: var(--muted); border: 1px solid var(--line2); }
.btn.small:hover { color: var(--gold2); border-color: var(--gold); }
.btn.danger { background: transparent; color: var(--red); border: 1px solid var(--red); }

/* ---- public/hidden -------------------------------------------------------- */
.hidden-card { border-color: #4a2c24; }
.hidden-card > h2 { color: #d98873; }
.secret-row { display: grid; grid-template-columns: 1fr 2fr auto; gap: 8px; margin-bottom: 8px; align-items: start; }
.secret-row .rev { grid-row: span 1; }
.rev-toggle { position: relative; }

/* ---- modal ----------------------------------------------------------------- */
.modal-bg { position: fixed; inset: 0; background: rgba(8,6,4,.8); backdrop-filter: blur(3px);
  z-index: 200; display: none; align-items: flex-start; justify-content: center; padding: 7vh 18px 30px; overflow: auto; }
.modal-bg.show { display: flex; }
.modal {
  background: var(--panel); border: 1px solid var(--line2); border-top: 3px solid var(--gold);
  border-radius: 11px; max-width: 760px; width: 100%; padding: 22px 26px 26px; box-shadow: var(--shadow);
  animation: pop .14s ease-out;
}
@keyframes pop { from { transform: translateY(10px); opacity: .4; } to { transform: none; opacity: 1; } }
.modal h3 { margin: 0 0 2px; font-size: 21px; color: var(--gold2); }
.modal .msub { font-family: sans-serif; font-size: 12px; color: var(--muted); margin-bottom: 14px; }
.modal .mclose { float: right; background: none; border: none; color: var(--muted); font-size: 20px; cursor: pointer; }
.modal .mclose:hover { color: var(--red); }
.modal p, .modal li { line-height: 1.62; font-size: 14.5px; color: #d8cfba; }
.modal .facts { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0 12px; }
.modal ul { padding-left: 20px; }
.modal .src { margin-top: 14px; font-family: sans-serif; font-size: 12px; color: var(--faint); border-top: 1px solid var(--line); padding-top: 10px; }
.modal .src a { color: var(--blue); }
.empty { color: var(--faint); font-family: sans-serif; font-size: 12.5px; font-style: italic; padding: 18px 4px; }

/* ---- save panel ------------------------------------------------------------- */
#save-msg { font-family: sans-serif; font-size: 13px; margin-top: 10px; }
#save-msg.ok { color: var(--green); } #save-msg.err { color: var(--red); }
#preview { display: none; white-space: pre-wrap; background: #0d0b08; border: 1px solid var(--line);
  border-radius: 9px; padding: 14px; font-family: 'Cascadia Code', Consolas, monospace; font-size: 12px;
  color: #b5c99a; max-height: 420px; overflow: auto; margin-top: 10px; }
.kv-add { display: flex; gap: 8px; margin-top: 8px; }
.kv-add input { flex: 1; }
</style>
</head>
<body>

<header>
  <div class="brand">⚜ Tabletop Character Forge <small>open systems · live 5e rules · drop-in campaigns</small></div>
  <select id="f-system" title="game system" style="min-width:230px"></select>
  <select id="f-campaign" title="campaign" style="min-width:250px"></select>
  <span class="saved-strip" id="saved-strip"></span>
</header>

<div class="cols">
<nav class="rail" id="rail">
  <a href="#sec-identity">🪪 Identity</a>
  <a href="#sec-abilities">🎲 Abilities</a>
  <a href="#sec-skills">📜 Skills &amp; Proficiencies</a>
  <a href="#sec-spells">✨ Spells &amp; Powers</a>
  <a href="#sec-levels">🔺 Level-Up Features</a>
  <a href="#sec-background">🏛 Background</a>
  <a href="#sec-campaign">🗺 Campaign</a>
  <a href="#sec-details">🧶 Details</a>
  <a href="#sec-knowledge">👁 Public vs Hidden</a>
  <a href="#sec-save">💾 Save</a>
</nav>

<main>

  <!-- ============ SYSTEM TLDR =========================================== -->
  <section class="card" id="sec-system">
    <h2><span class="ico">🧭</span> System <span id="sys-source"></span></h2>
    <div class="syspanel">
      <div>
        <label>System — picked up top</label>
        <div class="chip-row" id="sys-chips" style="margin-top:2px"></div>
        <p class="hint" id="sys-desc" style="margin-top:10px"></p>
        <div class="links" id="sys-links"></div>
      </div>
      <div class="tldr" id="sys-tldr"></div>
    </div>
  </section>

  <!-- ============ IDENTITY ============================================= -->
  <section class="card" id="sec-identity">
    <h2><span class="ico">🪪</span> Identity</h2>
    <div class="idrow">
      <div class="portrait-wrap">
        <div class="portrait" id="portrait" title="click to change portrait">🧙</div>
        <div class="portrait-pick" id="portrait-pick"></div>
      </div>
      <div style="flex:1; min-width:260px">
        <div class="grid2">
          <div>
            <label for="f-name">Character name <span style="color:var(--red)">*</span></label>
            <input type="text" id="f-name">
            <label for="f-player">Player name</label>
            <input type="text" id="f-player">
          </div>
          <div>
            <label for="f-level">Level</label>
            <input type="number" id="f-level" min="1" max="20" value="1">
            <label>Alignment</label>
            <input type="text" id="f-align">
            <div class="suggestions" id="sug-align"></div>
          </div>
        </div>
        <div class="grid2">
          <div>
            <label id="lbl-race">Race</label>
            <input type="text" id="f-race">
            <div class="suggestions" id="sug-race"></div>
          </div>
          <div>
            <label id="lbl-class">Class</label>
            <input type="text" id="f-class">
            <div class="suggestions" id="sug-class"></div>
          </div>
        </div>
        <div class="grid2">
          <div><label for="f-gender">Gender (optional)</label><input type="text" id="f-gender"></div>
          <div><label for="f-age">Age (optional)</label><input type="text" id="f-age"></div>
        </div>
        <label for="f-appearance">Appearance — what do other characters see?</label>
        <textarea id="f-appearance"></textarea>
        <div class="chip-row" id="id-chips"></div>
      </div>
    </div>
  </section>

  <!-- ============ ABILITIES ============================================= -->
  <section class="card" id="sec-abilities">
    <h2><span class="ico">🎲</span> Abilities</h2>
    <p class="hint" id="ab-hint">Click a tile to see which skills ride on it.</p>
    <div class="ability-grid" id="ability-grid"></div>
    <label for="f-abil-notes">Ability notes <span style="color:var(--faint)">(system-specific scoring, flavor)</span></label>
    <input type="text" id="f-abil-notes">
  </section>

  <!-- ============ SKILLS & PROFICIENCIES ================================ -->
  <section class="card" id="sec-skills">
    <h2><span class="ico">📜</span> Skills &amp; Proficiencies</h2>
    <p class="hint" id="skills-hint">Click a skill to read the full rule; set proficiency (base / expert).</p>
    <div id="skills-body"></div>
    <label for="f-skills-extra">Additional proficiencies (free-form)</label>
    <textarea id="f-skills-extra" placeholder="anything — languages, tool kits, vehicle handling…"></textarea>
  </section>

  <!-- ============ SPELLS & POWERS ======================================= -->
  <section class="card" id="sec-spells">
    <h2><span class="ico">✨</span> Spells &amp; Powers</h2>
    <p class="hint" id="spells-hint">The full 5e spell list (live from 5etools) — click any spell for the complete text, “+” knows it.</p>
    <div id="spells-body"></div>
  </section>

  <!-- ============ LEVEL-UP FEATURES ===================================== -->
  <section class="card" id="sec-levels">
    <h2><span class="ico">🔺</span> Level-Up Features <span class="badge gold" id="levels-class">—</span></h2>
    <p class="hint" id="levels-hint">Every feature your class grants, level by level. Your own level is marked.</p>
    <div id="levels-body"></div>
  </section>

  <!-- ============ BACKGROUND ============================================ -->
  <section class="card" id="sec-background">
    <h2><span class="ico">🏛</span> Background</h2>
    <div class="grid2">
      <div>
        <label id="lbl-bg">Background</label>
        <input type="text" id="f-bg">
        <div class="suggestions" id="sug-bg"></div>
        <div class="camp-detail" id="bg-detail" style="margin-top:10px"></div>
      </div>
      <div>
        <label for="f-bgs">Summary (1–3 sentences)</label>
        <textarea id="f-bgs"></textarea>
        <label for="f-bgdetail">Full backstory</label>
        <textarea id="f-bgdetail" style="min-height:120px"></textarea>
      </div>
    </div>
  </section>

  <!-- ============ CAMPAIGN ============================================== -->
  <section class="card" id="sec-campaign">
    <h2><span class="ico">🗺</span> Campaign</h2>
    <p class="hint">Pick a drop-in campaign up top — the panel below narrates it (setup, tone, world hooks the DM can run straight from).</p>
    <button class="btn small" id="camp-clear" style="margin-top:2px">✕ no campaign (open-ended)</button>
    <div class="camp-detail" id="camp-detail"></div>
    <div id="ai-seed-box" style="display:none; margin-top:14px">
      <label for="ai-seed">Campaign seed (for the AI narrator)</label>
      <textarea id="ai-seed" placeholder="e.g. a rain-soaked colony world where memories can be traded"></textarea>
      <label for="ai-title">Campaign title (optional)</label>
      <input type="text" id="ai-title">
    </div>
  </section>

  <!-- ============ DETAILS =============================================== -->
  <section class="card" id="sec-details">
    <h2><span class="ico">🧶</span> Details</h2>
    <div class="grid2">
      <div>
        <label for="f-personality">Personality</label>
        <textarea id="f-personality"></textarea>
        <label for="f-goals">Goals &amp; desires</label>
        <textarea id="f-goals"></textarea>
      </div>
      <div>
        <label for="f-flaws">Fears &amp; flaws</label>
        <textarea id="f-flaws"></textarea>
        <label for="f-traits">Traits / bonds / quirks</label>
        <textarea id="f-traits"></textarea>
      </div>
    </div>
    <div class="grid2" style="margin-top:14px">
      <div><label for="f-equipment">Equipment / inventory</label><textarea id="f-equipment"></textarea></div>
      <div><label for="f-languages">Languages / data-streams (free-form)</label><input type="text" id="f-languages"></div>
    </div>
    <label>Extra fields (key = value — fully open, stored in details.custom)</label>
    <div id="kv-list"></div>
    <div class="kv-add">
      <input type="text" id="kv-key" placeholder="key e.g. vehicle">
      <input type="text" id="kv-val" placeholder="value e.g. interceptor chopper">
      <button class="btn small" id="kv-add-btn">+ add</button>
    </div>
  </section>

  <!-- ============ PUBLIC vs HIDDEN ======================================= -->
  <section class="card" id="sec-knowledge">
    <h2><span class="ico">👁</span> Public — what the group knows</h2>
    <p class="hint">Everything other players (and their characters) are aware of. This is what an AI DM may share at the table (<span class="mono">?view=public</span>).</p>
    <div class="grid2">
      <div><label for="p-identity">Who they believe this person is</label><textarea id="p-identity"></textarea></div>
      <div><label for="p-backstory">Backstory the group knows</label><textarea id="p-backstory"></textarea></div>
      <div><label for="p-relations">Relationships the group sees</label><textarea id="p-relations"></textarea></div>
      <div><label for="p-items">Items the group has seen</label><textarea id="p-items"></textarea></div>
    </div>
    <label for="p-rumors">Rumors &amp; gossip circulating</label>
    <textarea id="p-rumors"></textarea>
  </section>

  <section class="card hidden-card" id="sec-hidden">
    <h2><span class="ico">🕯</span> Hidden — DM only</h2>
    <p class="hint">Secret motives, past sins, pacts, plot hooks. The AI DM may only reveal these when an item’s “revealed” flag is set.</p>
    <label>Hidden agendas</label><div id="agenda-list"></div>
    <button class="btn small" id="agenda-add">+ add hidden agenda</button>
    <label style="margin-top:16px">Secrets</label><div id="secret-list"></div>
    <button class="btn small" id="secret-add">+ add secret</button>
    <label for="h-dmnotes">DM notes (session hooks, foreshadowing)</label>
    <textarea id="h-dmnotes" style="min-height:100px"></textarea>
    <label style="margin-top:14px">
      <input type="checkbox" id="h-revealed" style="width:auto"> The group has been told this character’s hidden side (visibility.hidden_revealed)
    </label>
  </section>

  <!-- ============ SAVE ===================================================== -->
  <section class="card" id="sec-save">
    <h2><span class="ico">💾</span> Save</h2>
    <p class="hint">Writes <span class="mono">char_sheets/char_sheet_&lt;id&gt;.json</span> — one file per character, hidden section included.</p>
    <button class="btn" id="save-btn">⚜ Create character → JSON</button>
    <span id="save-msg"></span>
    <pre id="preview"></pre>
  </section>

</main>
</div>

<!-- ================= MODAL ============================================= -->
<div class="modal-bg" id="modal-bg">
  <div class="modal">
    <button class="mclose" id="modal-close">✕</button>
    <div id="modal-content"></div>
  </div>
</div>

<script src="webui.js"></script>
</body>
</html>
