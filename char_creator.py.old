        </div>
      </div>
      <label for="f-custom-fields">Extra fields (key = value, one per line — fully open)</label>
      <textarea id="f-custom-fields" placeholder="vehicle = black motorbike (one 'key = value' per line)"></textarea>
    </div>
  </section>

  <!-- Step 4 ---------------------------------------------------------- -->
  <section class="step" id="step-4">
    <div class="card">
      <h2>👁 Public data — known to the group</h2>
      <p class="hint">Everything the other players (and their characters) are aware of. This is what the AI DM will share at the table.</p>
      <label for="p-identity">Who they believe this person is</label>
      <textarea id="p-identity"></textarea>
      <label for="p-backstory">Backstory the group knows</label>
      <textarea id="p-backstory"></textarea>
      <div class="grid2">
        <div>
          <label for="p-relations">Relationships the group sees</label>
          <textarea id="p-relations"></textarea>
        </div>
        <div>
          <label for="p-items">Items the group has seen</label>
          <textarea id="p-items"></textarea>
        </div>
      </div>
      <label for="p-rumors">Rumors &amp; gossip circulating</label>
      <textarea id="p-rumors"></textarea>
    </div>
    <div class="card hidden-card">
      <h2>🕯 Hidden — DM only (not yet known to the group)</h2>
      <p class="hint">Secret motives, past sins, pacts, plot hooks. These stay out of the public sheet until you reveal them.</p>
      <label>Hidden agendas</label>
      <div id="agenda-list"></div>
      <button class="btn secondary" style="padding:7px 14px;font-size:13px;cursor:pointer" onclick="addSecret('agenda-list', 'agenda')">+ Add hidden agenda</button>
      <label style="margin-top:16px">Secrets</label>
      <div id="secret-list"></div>
      <button class="btn secondary" style="padding:7px 14px;font-size:13px;cursor:pointer" onclick="addSecret('secret-list', 'secret')">+ Add secret</button>
      <label for="h-dmnotes">DM notes (session hooks, foreshadowing, reminders)</label>
      <textarea id="h-dmnotes" style="min-height:110px"></textarea>
    </div>
  </section>

  <!-- Step 5 ---------------------------------------------------------- -->
  <section class="step" id="step-5">
    <div class="card">
      <h2>Save character</h2>
      <p class="hint">Creates <span class="badge">char_sheets/char_sheet_&lt;id&gt;.json</span> — one file per character, containing everything including the hidden section.</p>
      <button class="btn" id="save-btn" onclick="saveCharacter()">Create character → JSON</button>
      <p class="save-note" id="save-msg"></p>
      <div id="preview-box" style="display:none">
        <label>Generated JSON</label>
        <div id="preview"></div>
      </div>
    </div>
  </section>
</div>

<script>
const ABILITIES = ["strength","dexterity","constitution","intelligence","wisdom","charisma"];
const MOD = s => { s = parseInt(s) || 10; return (s - 10) / 2 < 0 ? Math.floor((s-10)/2) : Math.floor((s-10)/2); };
let games = {}, agendas = [], secrets = [];

// ---- navigation ----
document.querySelectorAll('#nav button').forEach(b => b.onclick = () => showStep(b.dataset.step));
function showStep(n) {
  document.querySelectorAll('section.step').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('#nav button').forEach(b => b.classList.toggle('active', b.dataset.step === n));
  document.getElementById('step-' + n).classList.add('active');
}

// ---- ability grid ----
const grid = document.getElementById('ability-grid');
ABILITIES.forEach(k => {
  const w = document.createElement('div');
  w.innerHTML = '<label>' + k + '</label><input type="number" min="1" max="30" value="10" data-ab="' + k + '" oninput="updateMods()"> <div class="mod" id="mod-' + k + '">+0</div>';
  grid.appendChild(w);
});
function updateMods() {
  let total = 0;
  document.querySelectorAll('[data-ab]').forEach(i => {
    const v = Math.max(1, Math.min(30, parseInt(i.value) || 10));
    const m = Math.floor((v - 10) / 2);
    document.getElementById('mod-' + i.dataset.ab).textContent = (m >= 0 ? '+' : '') + m;
    if (v >= 8 && v <= 15) total += v - 8;
    else total += ((v - 15) * 2) + 13; // 5e points-buy cost above 15
  });
  const note = document.getElementById('pb-note');
  note.textContent = 'D&D 5e points-buy (for reference): ' + total + ' / 27 points';
  note.style.color = total > 27 ? 'var(--red)' : 'var(--green)';
}
function applyPreset(p) {
  const sets = { standard: [15,14,13,12,10,8], default: [10,10,10,10,10,10], pointsbuy: [8,8,8,8,8,8] };
  sets[p].forEach((v, i) => { document.querySelector('[data-ab="' + ABILITIES[i] + '"]').value = v; });
  updateMods();
}

// ---- games & suggestions ----
async function loadGames() {
  const r = await fetch('/api/games'); games = await r.json();
  const sel = document.getElementById('f-system');
  sel.innerHTML = Object.entries(games).map(([id, g]) =>
    '<option value="' + id + '">' + g.label + '</option>').join('');
  sel.onchange = renderSuggestions;
  renderSuggestions();
}
function renderSuggestions() {
  const g = games[document.getElementById('f-system').value] || {};
  fillSug('sug-race', g.races || [], 'f-race');
  fillSug('sug-class', g.classes || [], 'f-class');
  fillSug('sug-bg', g.backgrounds || [], 'f-bg');
  fillSug('sug-align', g.alignments || [], 'f-align');
}
function fillSug(boxId, list, inputId) {
  const box = document.getElementById(boxId); box.innerHTML = '';
  list.forEach(t => {
    const b = document.createElement('button');
    b.textContent = t;
    b.onclick = () => {
      const el = document.getElementById(inputId);
      el.value = (t === 'Custom...') ? '' : t;
      el.focus();
      if (t === 'Custom...') el.placeholder = 'Type anything...';
    };
    box.appendChild(b);
  });
}

// ---- hidden items ----
function addSecret(listId, kind) {
  const list = document.getElementById(listId);
  const row = document.createElement('div');
  row.className = 'secret-row';
  row.innerHTML = '<input type="text" placeholder="Title">' +
                  '<textarea placeholder="Description — what the DM knows" style="min-height:44px"></textarea>' +
                  '<button title="Remove" onclick="this.parentNode.remove()">✕</button>';
  list.appendChild(row);
}
addSecret('agenda-list', 'agenda');
addSecret('secret-list', 'secret');

// ---- collect & save ----
function collect() {
  const v = id => document.getElementById(id).value.trim();
  const custom = {};
  v('f-custom-fields').split('\n').forEach(line => {
    const i = line.indexOf('=');
    if (i > 0) custom[line.slice(0, i).trim()] = line.slice(i + 1).trim();
  });
  const readList = id => {
    return [...document.querySelectorAll('#' + id + ' .secret-row')].map(r => {
      const [t, d] = r.querySelectorAll('input, textarea');
      return { title: t.value.trim(), description: d.value.trim(), revealed: false };
    }).filter(s => s.title || s.description);
  };
  return {
    system: document.getElementById('f-system').value,
    identity: {
      name: v('f-name'), race: v('f-race'), class: v('f-class'),
      level: parseInt(v('f-level')) || 1, gender: v('f-gender'), age: v('f-age'),
      appearance: v('f-appearance'), player_name: v('f-player'),
    },
    abilities: (() => {
      const a = {};
      document.querySelectorAll('[data-ab]').forEach(i => a[i.dataset.ab] = parseInt(i.value) || 10);
      a.notes = v('f-abil-notes');
      return a;
    })(),
    background: { summary: v('f-bgs'), details: v('f-bgdetail'), seed: v('f-bg') },
    details: {
      personality: v('f-personality'), goals: v('f-goals'), fears_flaws: v('f-flaws'),
      traits: v('f-traits'), alignment: v('f-align'), skills: v('f-skills'),
      equipment: v('f-equipment'), spells: v('f-spells'), languages: v('f-languages'),
      custom: custom,
    },
    public: {
      known_identity: v('p-identity'), known_backstory: v('p-backstory'),
      known_relationships: v('p-relations'), known_items: v('p-items'),
      rumors: v('p-rumors'),
    },
    hidden: {
      hidden_agendas: readList('agenda-list'),
      secrets: readList('secret-list'),
      dm_notes: v('h-dmnotes'),
    },
  };
}

const FIELD_MAP = { // for prefilling when editing — kept simple
};

async function saveCharacter() {
  const btn = document.getElementById('save-btn');
  const msg = document.getElementById('save-msg');
  btn.disabled = true; msg.textContent = 'Saving…';
  try {
    const payload = collect();
    if (!payload.identity.name) { msg.style.color = 'var(--red)'; msg.textContent = 'Please give your character a name.'; btn.disabled = false; return; }
    const r = await fetch('/api/characters', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const sheet = await r.json();
    msg.style.color = 'var(--green)';
    msg.textContent = 'Saved → char_sheets/char_sheet_' + sheet.id + '.json (view: /api/characters/' + sheet.id + ')';
    document.getElementById('preview').textContent = JSON.stringify(sheet, null, 2);
    document.getElementById('preview-box').style.display = 'block';
  } catch (e) {
    msg.style.color = 'var(--red)'; msg.textContent = 'Error: ' + e;
  }
  btn.disabled = false;
}

loadGames();
updateMods();
</script>
</body>
</html>
"""


@app.get("/")
def index():
    return render_template_string(HTML_PAGE)


@app.get("/health")
def health():
    return jsonify({"status": "ok", "sheets": list(SHEET_DIR.glob("char_sheet_*.json")) and [
        p.name for p in SHEET_DIR.glob("char_sheet_*.json")] or []})


if __name__ == "__main__":
    print("Char Creator running at http://127.0.0.1:5000")
    app.run(host="127.0.0.1", port=5000, debug=True)
