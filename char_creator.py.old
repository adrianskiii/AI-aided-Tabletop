        </div>
      </div>
    </div>
    <div class="card">
      <h2>Identity</h2>
      <div class="grid2">
        <div>
          <label for="f-name">Character name</label>
          <input type="text" id="f-name">
          <label for="f-level">Level / tier</label>
          <input type="number" id="f-level" min="1" max="120" value="1">
          <label for="f-gender">Gender (optional)</label>
          <input type="text" id="f-gender">
          <label for="f-age">Age (optional)</label>
          <input type="text" id="f-age">
        </div>
        <div>
          <label for="f-player">Player name</label>
          <input type="text" id="f-player" placeholder="Who is playing this character?">
          <label for="f-appearance">Appearance</label>
