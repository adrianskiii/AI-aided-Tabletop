"""
Char Creator — API-based, non-AI character creator for tabletop sessions.

Supports multiple game systems (D&D 5e, Pathfinder 2e, Baldur's Gate /
generic fantasy, or any custom system) with a deliberately open design:
every field can be freely edited, lists are suggestions, and every
selection supports "Custom".

Output: one JSON file per character (char_sheets/<id>.json) containing:
  - identity      (name, race, class, level, ...)
  - abilities     (six scores + derived modifiers + notes)
  - background    (full backstory)
  - details       (personality, goals, flaws, equipment, spells, free-form)
  - public        (everything the GROUP already knows)
  - hidden        (DM-only: hidden agendas, secrets, DM notes — NOT
                   known to the group yet)

Run:  python3 char_creator.py   →   http://127.0.0.1:5000
"""

import uuid
import json
import copy
from datetime import datetime, timezone
from pathlib import Path

from flask import Flask, request, jsonify, render_template_string

# --------------------------------------------------------------------------- #
#  Config                                                                      #
# --------------------------------------------------------------------------- #

BASE_DIR = Path(__file__).resolve().parent
SHEET_DIR = BASE_DIR / "char_sheets"
SHEET_DIR.mkdir(exist_ok=True)

app = Flask(__name__)

ABILITY_KEYS = ["strength", "dexterity", "constitution",
                "intelligence", "wisdom", "charisma"]


def _now():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


# --------------------------------------------------------------------------- #
#  Game data — suggestions only, everything can be typed freely                #
# --------------------------------------------------------------------------- #

GAMES = {
    "dnd5e": {
        "label": "D&D 5e",
        "races": ["Human", "Elf", "Dwarf", "Halfling", "Dragonborn",
                  "Gnome", "Half-Elf", "Half-Orc", "Tiefling",
                  "Aarakocra", "Goblin", "Tabaxi", "Custom..."],
        "classes": ["Barbarian", "Bard", "Cleric", "Druid", "Fighter",
                    "Monk", "Paladin", "Ranger", "Rogue", "Sorcerer",
                    "Warlock", "Wizard", "Custom..."],
        "backgrounds": ["Acolyte", "Charlatan", "Criminal", "Entertainer",
                        "Folk Hero", "Guild Artisan", "Hermit", "Noble",
                        "Outlander", "Sage", "Sailor", "Soldier", "Urchin",
                        "Custom..."],
        "alignments": ["Lawful Good", "Neutral Good", "Chaotic Good",
                       "Lawful Neutral", "True Neutral", "Chaotic Neutral",
                       "Lawful Evil", "Neutral Evil", "Chaotic Evil",
                       "Unaligned"],
    },
    "pathfinder2e": {
        "label": "Pathfinder 2e",
        "races": ["Human", "Elf", "Dwarf", "Halfling", "Gnome", "Orc",
                  "Half-Elf", "Half-Orc", "Goblin", "Refluaan",
                  "Tengu", "Custom..."],
        "classes": ["Alchemist", "Barbarian", "Burglar", "Champion",
                    "Druid", "Fighter", "Guardian", "Inquisitor",
                    "Inventor", "Magus", "Mystic", "Oracle", "Ranger",
                    "Rogue", "Scholar", "Swashbuckler", "Thaumaturge",
                    "Witch", "Warden", "Custom..."],
        "backgrounds": ["Academic", "Artisan", "Criminal", "Cult Adept",
                        "Far Traveler", "Mystic", "Noble", "Outlander",
                        "Sailor", "Soldier", "Streetwise",
                        "Veteran of the Lost Kingdom", "Custom..."],
        "alignments": ["Good", "Neutral", "Evil",
                       "Lawful Good", "Lawful Neutral", "Lawful Evil",
                       "Chaotic Good", "Chaotic Neutral", "Chaotic Evil"],
    },
    "bg": {
        "label": "Baldur's Gate / Generic Fantasy",
        "races": ["Human", "Halfling", "Dwarf", "Elf", "Gnome", "Dragonbreath",
                  "Shalar", "Uthgardt", "Illuskan", "Amnian", "Custom..."],
        "classes": ["Warrior", "Sorcerous Adept", "Mage", "Cleric", "Rogue",
                    "Armed Rogue", "Monk", "Shapeshifter",
                    "Spellscout", "Custom..."],
        "backgrounds": ["Bhaalspear", "Child of the Watch", "Torchbearer",
                        "Guttered", "Wandering Hermit", "Soldier of the Harpers",
                        "Hollow One", "Custom..."],
        "alignments": ["Any", "Good", "Neutral", "Evil",
                       "Lawful", "Chaotic", "Custom..."],
    },
    "custom": {
        "label": "Custom System (pure free-form)",
        "races": ["Custom..."],
        "classes": ["Custom..."],
        "backgrounds": ["Custom..."],
        "alignments": ["Custom..."],
    },
}


# --------------------------------------------------------------------------- #
#  Character storage helpers                                                   #
# --------------------------------------------------------------------------- #

def new_sheet(system: str) -> dict:
    """Blank character sheet in the target JSON shape."""
    return {
        "id": uuid.uuid4().hex[:12],
        "system": system,
        "system_label": GAMES.get(system, {}).get("label", "Custom System"),
        "created_at": _now(),
        "updated_at": _now(),
        "visibility": {"hidden_revealed": False},
        "identity": {
            "name": "",
            "race": "",
            "class": "",
            "level": 1,
            "gender": "",
            "age": "",
            "appearance": "",
            "player_name": "",
        },
        "abilities": {
            "strength": 10, "dexterity": 10, "constitution": 10,
            "intelligence": 10, "wisdom": 10, "charisma": 10,
            "points_buy_used": 0,
            "notes": "",
        },
        "background": {
            "seed": "",
            "summary": "",
            "details": "",
        },
        "details": {
            "personality": "",
            "goals": "",
            "fears_flaws": "",
            "traits": "",
            "alignment": "",
            "languages": "",
            "skills": "",
            "equipment": "",
            "spells": "",
            "custom": {},  # free-form extra fields (key → value)
        },
        # ---- Public: known to the group ---------------------------------- #
        "public": {
            "known_identity": "",       # who they believe this person is
            "known_backstory": "",      # what the group knows about the past
            "known_relationships": "",  # NPCs the group sees them with
            "known_items": "",          # items the group has seen
            "rumors": "",               # rumors the group has heard
        },
        # ---- Hidden: DM-only, not (yet) known to the group --------------- #
        "hidden": {
            "hidden_agendas": [],  # [{title, description, revealed}]
            "secrets": [],         # [{title, description, revealed}]
            "dm_notes": "",
        },
    }


def _modify(score: int) -> int:
    return (int(score) - 10) // 2


def derive(sheet: dict) -> dict:
    """Recompute derived fields (modifiers) and keep them consistent."""
    sheet["abilities"]["modifiers"] = {
        k: _modify(sheet["abilities"].get(k, 10)) for k in ABILITY_KEYS
    }
    return sheet


def sheet_path(sheet_id: str) -> Path:
    return SHEET_DIR / f"char_sheet_{sheet_id}.json"


def load_sheet(sheet_id: str):
    path = sheet_path(sheet_id)
    if not path.exists():
        return None
    with open(path, "r", encoding="utf-8") as f:
        return json.load(f)


def save_sheet(sheet: dict) -> dict:
    sheet = derive(sheet)
    sheet["updated_at"] = _now()
    with open(sheet_path(sheet["id"]), "w", encoding="utf-8") as f:
        json.dump(sheet, f, indent=2, ensure_ascii=False)
    return sheet


# --------------------------------------------------------------------------- #
#  REST API                                                                    #
# --------------------------------------------------------------------------- #

@app.get("/api/games")
def api_games():
    return jsonify(GAMES)


@app.get("/api/characters")
def api_list_characters():
    sheets = []
    for p in sorted(SHEET_DIR.glob("char_sheet_*.json")):
        try:
            with open(p, encoding="utf-8") as f:
                s = json.load(f)
            # list view: never leak hidden info
            sheets.append({
                "id": s["id"],
                "name": s.get("identity", {}).get("name", ""),
                "system_label": s.get("system_label", ""),
                "player": s.get("identity", {}).get("player_name", ""),
                "created_at": s.get("created_at", ""),
            })
        except (json.JSONDecodeError, KeyError):
            continue
    return jsonify(sheets)


@app.get("/api/characters/<sheet_id>")
def api_get_character(sheet_id: str):
    """?view=public → only what the group knows (no hidden block)."""
    sheet = load_sheet(sheet_id)
    if sheet is None:
        return jsonify({"error": "character not found"}), 404
    if request.args.get("view") == "public":
        public_view = {k: v for k, v in sheet.items() if k != "hidden"}
        public_view["visibility"]["hidden_revealed"] = False
        return jsonify(public_view)
    return jsonify(sheet)


@app.post("/api/characters")
def api_create_character():
    payload = request.get_json(silent=True) or {}
    system = payload.pop("system", "dnd5e")
    if system not in GAMES:
        system = "custom"
    sheet = new_sheet(system)
    # merge whatever the client sent (allow open fields, ignore unknown keys)
    _merge(sheet, payload)
    sheet = save_sheet(sheet)
    return jsonify(sheet), 201


@app.put("/api/characters/<sheet_id>")
def api_update_character(sheet_id: str):
    sheet = load_sheet(sheet_id)
    if sheet is None:
        return jsonify({"error": "character not found"}), 404
    payload = request.get_json(silent=True) or {}
    _merge(sheet, payload)
    return jsonify(save_sheet(sheet))


@app.delete("/api/characters/<sheet_id>")
def api_delete_character(sheet_id: str):
    path = sheet_path(sheet_id)
    if not path.exists():
        return jsonify({"error": "character not found"}), 404
    path.unlink()
    return jsonify({"deleted": sheet_id})


@app.post("/api/characters/<sheet_id>/toggle-hidden")
def api_toggle_hidden(sheet_id: str):
    """Mark hidden data as revealed to the group (end of session, twists...)."""
    sheet = load_sheet(sheet_id)
    if sheet is None:
        return jsonify({"error": "character not found"}), 404
    sheet["visibility"]["hidden_revealed"] = (
        not sheet.get("visibility", {}).get("hidden_revealed", False)
    )
    return jsonify(save_sheet(sheet))


def _merge(target: dict, payload: dict):
    """Deep-merge the client payload into the sheet, keeping known shape."""
    for key, value in payload.items():
        if key in ("id", "created_at", "updated_at", "system"):
            continue
        if key in target and isinstance(target[key], dict):
            if isinstance(value, dict):
                for sub_key, sub_value in value.items():
                    if sub_key in target[key]:
                        target[key][sub_key] = sub_value
                    elif sub_key == "custom" and isinstance(sub_value, dict):
                        target[key].setdefault("custom", {}).update(sub_value)
            continue
        if key == "abilities":
            if isinstance(value, dict):
                for ab in ABILITY_KEYS:
                    if ab in value:
                        try:
                            sheet_val = int(value[ab])
                            sheet_val = max(1, min(30, sheet_val))
                            target[key][ab] = sheet_val
                        except (TypeError, ValueError):
                            continue
                for extra in ("notes", "points_buy_used"):
                    if extra in value:
                        target[key][extra] = value[extra]
            continue
        if key in target and isinstance(target[key], list):
            if isinstance(value, list):
                target[key] = [v for v in value if isinstance(v, (str, dict))]
            continue
        target[key] = value


