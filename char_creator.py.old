        </div>
      </div>
    </div>
    <div class="card">
      <h2>Background (seed)</h2>
      <div class="grid2">
        <div>
          <label for="f-bg">Background</label>
          <input type="text" id="f-bg" placeholder="e.g. Urchin — or anything">
          <div class="suggestions" id="sug-bg"></div>
        </div>
        <div>
          <label for="f-bgs">Background summary (1–3 sentences)</label>
          <textarea id="f-bgs" placeholder="Where does this character come from?"></textarea>
        </div>
      </div>
    </div>
  </section>

  <!-- Step 2 ---------------------------------------------------------- -->
  <section class="step" id="step-2">
    <div class="card">
      <h2>Ability scores</h2>
      <p class="hint">Roll &amp; write the results here — or pick a preset. Anything from 1 to 30 is accepted; modifiers are computed automatically. (D&D 5e points-buy: max 27 points, scores 8–15.)</p>
      <div class="grid3" style="margin-bottom:10px">
        <button class="btn secondary" style="padding:8px;cursor:pointer" onclick="applyPreset('standard')">Standard array (15/14/13/12/10/8)</button>
        <button class="btn secondary" style="padding:8px;cursor:pointer" onclick="applyPreset('default')">All 10s</button>
        <button class="btn secondary" style="padding:8px;cursor:pointer" onclick="applyPreset('pointsbuy')">Reset to 8s (points buy)</button>
      </div>
      <div class="abilities grid3" id="ability-grid"></div>
      <p class="save-note" id="pb-note"></p>
      <label for="f-abil-notes">Ability notes (flavored scores, e.g. “Grit” for a pulp system)</label>
      <textarea id="f-abil-notes"></textarea>
    </div>
  </section>

  <!-- Step 3 ---------------------------------------------------------- -->
  <section class="step" id="step-3">
    <div class="card">
      <h2>Backstory</h2>
      <label for="f-bgdetail">Full backstory</label>
      <textarea id="f-bgdetail" style="min-height:140px"></textarea>
    </div>
    <div class="card">
      <h2>Character details</h2>
      <div class="grid2">
        <div>
          <label for="f-personality">Personality</label>
