HTML_PAGE = """<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Char Creator — Tabletop DM</title>
<style>
  :root {
    --bg: #14161d; --panel: #1e212b; --panel2: #262a37;
    --ink: #e8e6e1; --muted: #9aa0b4; --line: #343a4c;
    --gold: #d4a94e; --green: #6fbf8b; --red: #d46a5e;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink); font-family: Georgia, 'Times New Roman', serif; }
  header { padding: 18px 28px; border-bottom: 1px solid var(--line); display: flex; align-items: baseline; gap: 14px; }
  header h1 { margin: 0; font-size: 22px; letter-spacing: 1px; color: var(--gold); }
  header span { color: var(--muted); font-size: 13px; font-family: sans-serif; }
  .wrap { max-width: 980px; margin: 0 auto; padding: 24px 20px 80px; }
  nav { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 22px; font-family: sans-serif; }
  nav button { background: var(--panel); color: var(--muted); border: 1px solid var(--line);
    padding: 8px 14px; border-radius: 8px; cursor: pointer; font-size: 13px; }
  nav button.active { background: var(--gold); color: #1a1a1a; border-color: var(--gold); font-weight: bold; }
  section.step { display: none; }
  section.step.active { display: block; }
  .card { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 20px 22px; margin-bottom: 18px; }
  .card h2 { margin: 0 0 4px; font-size: 17px; color: var(--gold); }
  .card p.hint { margin: 0 0 14px; color: var(--muted); font-size: 13px; font-family: sans-serif; }
  label { display: block; font-size: 12px; color: var(--muted); font-family: sans-serif; margin: 12px 0 4px; text-transform: uppercase; letter-spacing: .5px; }
  input[type=text], input[type=number], textarea, select {
    width: 100%; background: var(--panel2); color: var(--ink);
    border: 1px solid var(--line); border-radius: 8px; padding: 9px 11px;
    font-family: inherit; font-size: 14px; }
  input:focus, textarea:focus, select:focus { outline: none; border-color: var(--gold); }
  textarea { resize: vertical; min-height: 70px; }
  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 18px; }
  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0 14px; }
  @media (max-width: 700px) { .grid2, .grid3 { grid-template-columns: 1fr; } }
  .suggestions { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
  .suggestions button { background: transparent; border: 1px solid var(--line); color: var(--muted);
    font-family: sans-serif; font-size: 12px; padding: 4px 10px; border-radius: 999px; cursor: pointer; }
  .suggestions button:hover { border-color: var(--gold); color: var(--gold); }
  .abilities input { text-align: center; width: 70px; }
  .mod { text-align: center; color: var(--gold); font-family: sans-serif; font-size: 13px; min-height: 20px; }
  .hidden-card { border-color: rgba(212, 106, 94, .5); }
  .hidden-card h2 { color: var(--red); }
  .secret-row { display: grid; grid-template-columns: 1fr 2fr auto; gap: 8px; margin-bottom: 8px; align-items: start; }
  .secret-row button { background: var(--panel2); border: 1px solid var(--line); color: var(--red);
    border-radius: 8px; cursor: pointer; padding: 0 10px; }
  .btnbar { display: flex; justify-content: space-between; margin-top: 20px; }
  .btn { background: var(--gold); color: #1a1a1a; border: none; border-radius: 8px;
    padding: 11px 26px; font-family: sans-serif; font-size: 14px; font-weight: bold; cursor: pointer; }
  .btn.secondary { background: var(--panel2); color: var(--muted); border: 1px solid var(--line); font-weight: normal; }
  .btn:disabled { opacity: .5; cursor: wait; }
  #preview { white-space: pre-wrap; background: #0f1118; border: 1px solid var(--line);
    border-radius: 12px; padding: 18px; font-family: 'Cascadia Code', Consolas, monospace;
    font-size: 12.5px; max-height: 520px; overflow: auto; color: #cfe8d8; }
  .save-note { font-family: sans-serif; font-size: 13px; color: var(--green); margin: 10px 0 0; }
  .badge { font-family: sans-serif; font-size: 11px; background: var(--panel2); border: 1px solid var(--line);
    padding: 3px 9px; border-radius: 999px; color: var(--muted); }
</style>
</head>
<body>
<header>
  <h1>⚔ Char Creator</h1>
  <span>Open character creator — pick a system, or invent everything freely.</span>
</header>
<div class="wrap">
  <nav id="nav">
    <button data-step="1" class="active">1 · Game &amp; Identity</button>
    <button data-step="2">2 · Abilities</button>
    <button data-step="3">3 · Background &amp; Details</button>
